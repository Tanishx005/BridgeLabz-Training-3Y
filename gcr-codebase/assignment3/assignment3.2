<!DOCTYPE html>
<html>
<head>
    <title>Product Catalog</title>
</head>

<body>

    <h1>Online Store - Product Catalog</h1>

    <table border="1" cellpadding="10" cellspacing="0">
        
        <!-- Table Heading -->
        <tr>
            <th colspan="5">Product Catalog</th>
        </tr>

        <tr>
            <th>Product Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Availability</th>
            <th>Category</th>
        </tr>

        <!-- Product 1 -->
        <tr>
            <td>
                <img src="https://via.placeholder.com/100" 
                     alt="Laptop" width="100" height="100">
                <br>
                Laptop
            </td>
            <td>Powerful laptop suitable for study, work and gaming.</td>
            <td>₹55,000</td>
            <td>In Stock</td>
            <td rowspan="2">Electronics</td>
        </tr>

        <!-- Product 2 -->
        <tr>
            <td>
                <img src="https://via.placeholder.com/100" 
                     alt="Headphones" width="100" height="100">
                <br>
                Headphones
            </td>
            <td>Wireless headphones with high-quality sound.</td>
            <td>₹2,500</td>
            <td>In Stock</td>
        </tr>

        <!-- Product 3 -->
        <tr>
            <td>
                <img src="https://via.placeholder.com/100" 
                     alt="Backpack" width="100" height="100">
                <br>
                Backpack
            </td>
            <td>Durable backpack suitable for college and travel.</td>
            <td>₹1,200</td>
            <td>Available</td>
            <td>Accessories</td>
        </tr>

        <!-- Product 4 -->
        <tr>
            <td>
                <img src="https://via.placeholder.com/100" 
                     alt="Smartphone" width="100" height="100">
                <br>
                Smartphone
            </td>
            <td>Modern smartphone with a high-resolution camera.</td>
            <td>₹25,000</td>
            <td>Out of Stock</td>
            <td>Mobile</td>
        </tr>

        <!-- Footer -->
        <tr>
            <td colspan="5">
                All prices are inclusive of applicable taxes.
            </td>
        </tr>

    </table>

</body>
</html>